// Boosted: buy random upgrades to your equipment with gold earned in play.
// A rewrite-engine reference mod modelled on the capabilities of MGMod's
// Boosted plugin (offers, rarities, linked/blocked/nerfed keys, bans,
// currency); written from scratch against this engine's public API.
"Mod"
{
    "Id"              "boosted"
    "Version"         "1.0.0"
    "ApiVersion"      "1"
    "DisplayNameKey"  "#boosted_title"
    "ServerScripts"   "1"
    "ClientAssets"    "1"
    "Dependencies"    { "base.game" ">=1.0.0" }
}
