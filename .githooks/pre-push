#!/bin/sh
# Refuse to push any commit (or tag) carrying another identity or trailer.
. "$(dirname "$0")/identity.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac  # branch deletion
  if [ "$remote_oid" = "$zero" ] || ! git cat-file -e "$remote_oid" 2>/dev/null; then
    range=$local_oid
  else
    range=$remote_oid..$local_oid
  fi
  bad=$(git log --format='%H%x09%an <%ae>%x09%cn <%ce>' "$range" |
    awk -F '\t' -v id="$ALLOWED_IDENT" '$2 != id || $3 != id')
  if [ -n "$bad" ]; then
    echo "pre-push: $local_ref contains commits with another identity:" >&2
    echo "$bad" >&2
    status=1
  fi
  trailers=$(git log --format='%H%x09%(trailers:only,unfold)' "$range" |
    grep -iE '(co-authored-by|signed-off-by|co-developed-by):' | grep -vF "$ALLOWED_IDENT")
  if [ -n "$trailers" ]; then
    echo "pre-push: $local_ref contains trailers naming someone else:" >&2
    echo "$trailers" >&2
    status=1
  fi
  if [ "$(git cat-file -t "$local_oid")" = tag ]; then
    tagger=$(git for-each-ref --format='%(taggername) %(taggeremail)' "$local_ref")
    if [ "$tagger" != "$ALLOWED_IDENT" ]; then
      echo "pre-push: tag $local_ref was made by '$tagger'." >&2
      status=1
    fi
  fi
done
exit $status
